meta {
  name: Create Product
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/products
  body: json
  auth: none
}

body:json {
  {
    "slug": "wireless-studio-headphones",
    "name": "Wireless Studio Headphones",
    "category": "Audio & Sound",
    "subcategory": "Over-Ear Monitors",
    "description": "Wireless headphones for studio monitoring",
    "imageUrl": "https://example.com/images/wireless-studio-headphones.jpg",
    "imageAlt": "Wireless studio headphones",
    "price": 349.99,
    "rating": 4.8,
    "reviewCount": 24,
    "badge": "NEW RELEASE",
    "badgeTone": "blue",
    "specs": "Bluetooth 5.4 • 40mm drivers",
    "series": "Studio",
    "attributes": {
      "driverSize": "40mm",
      "wireless": true
    },
    "connectivities": ["Bluetooth", "USB-C"],
    "finishes": ["Black"],
    "stock": 120,
    "inStock": true,
    "noiseCancelling": true
  }
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}
