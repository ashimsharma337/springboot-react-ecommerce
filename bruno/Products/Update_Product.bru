meta {
  name: Update Product
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/products/1
  body: json
  auth: none
}

body:json {
  {
    "id": 1,
    "slug": "updated-studio-headphones",
    "name": "Updated Studio Headphones",
    "category": "Audio & Sound",
    "subcategory": "Over-Ear Monitors",
    "price": 1299.99,
    "description": "Updated description for the laptop",
    "imageUrl": "https://example.com/images/updated-studio-headphones.jpg",
    "imageAlt": "Updated studio headphones",
    "rating": 4.9,
    "reviewCount": 32,
    "badge": "BESTSELLER",
    "badgeTone": "dark",
    "specs": "Bluetooth 5.4 • 55-hour battery",
    "series": "Studio",
    "attributes": {
      "driverSize": "40mm",
      "wireless": true
    },
    "connectivities": ["Bluetooth", "USB-C"],
    "finishes": ["Black", "Silver"],
    "stock": 25,
    "inStock": true,
    "noiseCancelling": true
  }
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}
